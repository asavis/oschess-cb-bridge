{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oschess bridge",
  "mainBinaryName": "oschess-bridge",
  "identifier": "org.oschess.bridge",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Ukrainian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER: the owner replaces this with the public key from `npx @tauri-apps/cli signer generate` (docs/release.md). Until then the app does not look for updates.",
      "endpoints": ["https://github.com/asavis/oschess-cb-bridge/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
