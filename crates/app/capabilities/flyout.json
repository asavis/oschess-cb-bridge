{
  "identifier": "flyout",
  "description": "The status flyout: reads the bridge's state, opens oschess and the settings, and sizes itself.",
  "windows": ["flyout"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-view",
    "allow-open-oschess",
    "allow-open-settings",
    "allow-hide-flyout",
    "allow-fit-flyout"
  ]
}
