<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (#112). scripts/msix.py fills in the identity
  from Partner Center and the version from Cargo.toml. The package holds the
  same oschess-bridge.exe as the NSIS installer, the images from icons/msix,
  and the pinned Stockfish under engines\stockfish-<version>.
  The Store signs the package; runFullTrust lets the app serve the loopback
  port and read the databases wherever they are, as the installed app does.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="@NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>oschess bridge</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="uk-UA" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="oschess-bridge.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="oschess bridge"
        Description="Opens your ChessBase databases and a chess engine in oschess"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- «Start with Windows»: the app enables this task (channel::STARTUP_TASK). -->
        <desktop:Extension Category="windows.startupTask" Executable="oschess-bridge.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="oschessBridgeStartup" Enabled="false" DisplayName="oschess bridge" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
